QUIZ sobre sistemas operacionais e lógica de programação
let pontos = 0;
let erros = 0;

console.log(&quot;Seja bem-vindo ao nosso QUIZ sobre sistemas operacionais e
lógica de programação\n&quot;);

// Pergunta 1
let operadores = prompt(&quot;1. O que é um sistema operacional?\nA. Um tipo de
hardware\nB. Um programa que gerencia o computador\nC. Um antivírus\nD.
Um dispositivo de entrada&quot;);

if (operadores.toLowerCase() === &quot;b&quot;) {
console.log(&quot;Correto!&quot;);
pontos++;
} else {
console.log(&quot;Errado!&quot;);
erros++;
}

